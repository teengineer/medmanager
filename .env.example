# Bundan Var — production / Dokploy environment.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
# On Dokploy, set these in the service's Environment tab (the .env file is only
# needed for docker compose / local runs).

# ── Database: Turso (remote libsql) ──────────────────────────────────────────
# Create with: turso db create bundanvar && turso db show --url bundanvar
#              turso db tokens create bundanvar
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Better Auth (required) ───────────────────────────────────────────────────
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-long-random-string
# Public origin of the deployed app (your Dokploy domain), no trailing slash.
BETTER_AUTH_URL=https://bundanvar.ilg.az
# Same origin — added to Better Auth trustedOrigins / cookie domain.
WEB_ORIGIN=https://bundanvar.ilg.az

# ── Expiry cron guard (required for the daily notifier) ──────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-random-string

# ── Google OAuth (optional — leave empty to disable Google sign-in) ──────────
# Authorized redirect URI: https://bundanvar.ilg.az/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push / VAPID (optional — leave empty to disable push notifications) ───
# Generate a key pair with: npx web-push generate-vapid-keys
PUSH_SUBJECT=mailto:admin@bundanvar.ilg.az
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
