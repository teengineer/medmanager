# Copy to .env and fill in values (never commit .env)

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Default=Data Source=medmanager.db
Jwt__Issuer=medmanager
Jwt__Audience=medmanager-web
Jwt__SigningKey=change-me-to-a-long-random-string-min-32-chars

# Web
VITE_API_BASE_URL=http://localhost:5080
