# Local development env vars. Copy to apps/web/.env.local and fill in real values.
# .env / .env.local are gitignored — never commit secrets to .env.example either.

# Database — Turso URL (recommended for prod) or leave for local SQLite file
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Better Auth — required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Origin allowed by Better Auth's CORS / cookie domain
WEB_ORIGIN=http://localhost:5173

# Cron endpoint guard
CRON_SECRET=

# Google OAuth (optional — leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (optional — leave empty to disable push notifications)
PUSH_SUBJECT=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
