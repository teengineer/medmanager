{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=medmanager.db"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "medmanager",
    "Audience": "medmanager-web",
    "SigningKey": "dev-only-replace-with-openssl-rand-base64-48-in-production-abc123",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Push": {
    "Subject": "mailto:admin@medmanager.local",
    "PublicKey": "",
    "PrivateKey": ""
  }
}
