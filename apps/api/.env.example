# Local dev — file-backed SQLite
DATABASE_URL=file:./medmanager.db

# Production (Turso) — uncomment and fill in
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...

PORT=5080
NODE_ENV=development

# JWT — generate with: openssl rand -base64 48
JWT_ISSUER=medmanager
JWT_AUDIENCE=medmanager-web
JWT_SIGNING_KEY=dev-only-replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Web Push VAPID — generate with: npx web-push generate-vapid-keys
PUSH_SUBJECT=mailto:admin@medmanager.local
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
