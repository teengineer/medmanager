# Copy to deploy/.env on the server (never commit)

# Image tag (leave as "latest" or pin to a SHA)
GITHUB_OWNER=teengineer
API_TAG=latest

# Public API hostname (must point at this server's IP)
API_DOMAIN=api.medmanager.example.com

# Web origin allowed by CORS
WEB_ORIGIN=https://medmanager.example.com

# JWT — generate with: openssl rand -base64 48
JWT_ISSUER=medmanager
JWT_AUDIENCE=medmanager-web
JWT_SIGNING_KEY=replace-me

# Web Push VAPID — generate with: npx web-push generate-vapid-keys
PUSH_SUBJECT=mailto:admin@medmanager.local
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# S3-compatible backup target (Litestream)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=medmanager-backups
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
