# Dependencies & build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.vite
**/.tanstack
.pnpm-store

# Local SQLite leftovers (prod uses Neon PostgreSQL)
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets — never bake these into the image
.env
.env.local
.env.*.local
apps/web/.env
apps/web/.env.local

# VCS & tooling
.git
.github
.claude
.idea
.vscode

# Netlify (not used on Dokploy)
netlify
netlify.toml

# OS / logs
**/.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*
