{
  "name": "medmanager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @medmanager/api test",
    "api:dev": "pnpm --filter @medmanager/api dev",
    "api:test": "pnpm --filter @medmanager/api test",
    "api:build": "pnpm --filter @medmanager/api build",
    "api:migrate": "pnpm --filter @medmanager/api db:migrate",
    "api:generate": "pnpm --filter @medmanager/api db:generate"
  }
}
